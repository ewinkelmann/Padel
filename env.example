# Copie este arquivo para ".env" e preencha os valores antes de iniciar o servidor.

# Conta administradora (criada automaticamente na primeira vez que o servidor sobe).
# Depois de criada, o admin pode trocar a propria senha pela tela "Trocar senha".
ADMIN_NOME="Eduardo"
ADMIN_EMAIL="seuemail@exemplo.com"
ADMIN_PASSWORD="escolha-uma-senha-forte"

# Chave secreta usada para assinar os tokens de login (cookies). Gere uma string
# aleatoria longa, por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-string-aleatoria-bem-longa"

# Porta em que o servidor vai escutar (a maioria dos servicos de hospedagem
# define isso automaticamente - so mude se estiver rodando localmente).
PORT=3000

# Ambiente: "production" ativa cookies seguros (exigem HTTPS, o que os servicos
# de hospedagem gratuitos ja fornecem). Em desenvolvimento local, deixe vazio.
NODE_ENV=production

# --- E-mail (necessario para "Esqueci minha senha") ---------------------
# Sem essas variaveis, o site continua funcionando normalmente, mas o link de
# redefinicao de senha nao e enviado por e-mail de verdade (so aparece no log
# do servidor - util para testar localmente). Veja no README.md como conseguir
# credenciais SMTP gratuitas (recomendamos o Brevo, ate 300 e-mails/dia gratis).
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="seu-usuario-smtp"
SMTP_PASS="sua-senha-ou-chave-smtp"
SMTP_FROM="Padel Ranking <naoresponda@seudominio.com>"

# Endereco publico do site, usado para montar o link dentro do e-mail de
# redefinicao de senha (ex.: https://padel-ranking.onrender.com). Se voce nao
# definir isso, o site tenta descobrir sozinho a partir do endereco acessado -
# normalmente funciona sem precisar mexer aqui.
SITE_URL=
